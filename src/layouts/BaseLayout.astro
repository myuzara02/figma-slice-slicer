---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
};

const { theme = "inherit", ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
  </head>
  <body class:list={[theme !== "inherit" && `u-theme-${theme}`]}>
    <SkipLink />
    <slot name="nav" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
