---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Overlay style. */
  variant?: "solid" | "gradient";
  /**
   * Tint strength as a percentage.
   *
   * @min 0
   * @max 100
   * @int
   */
  strength?: number;
}

const {
  render = true,
  variant = "solid",
  strength = 50,
  class: className,
  ...rest
} = Astro.props;
---

{
  render && (
    <div
      class:list={[
        "overlay_wrap",
        variant !== "solid" && `is-${variant}`,
        className,
      ]}
      style={`--_strength: ${strength};`}
      {...rest}
    />
  )
}

<style is:global>
  @layer components {
    .overlay_wrap {
      --_shade: var(--_primitives---colors--neutral-darkest);
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-color: color-mix(
        in srgb,
        var(--_shade) calc(var(--_strength, 50) / 100 * 80%),
        transparent
      );

      &.is-gradient {
        background-color: color-mix(
          in srgb,
          var(--_shade) calc(var(--_strength, 50) / 100 * 60%),
          transparent
        );
        background-image: linear-gradient(
          to bottom,
          transparent,
          color-mix(
              in srgb,
              var(--_shade) calc(var(--_strength, 50) / 100 * 62%),
              transparent
            )
            84%
        );
      }
    }
  }
</style>
