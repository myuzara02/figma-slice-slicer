---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import close from "@/assets/icons/close.svg";
import play from "@/assets/icons/play.svg";
import pause from "@/assets/icons/pause.svg";
import { slotContent } from "@/utils/slots.ts";

type Emphasis = "primary" | "secondary" | "tertiary" | "quaternary";

type Tag =
  | (HTMLAttributes<"button"> & {
      /** Rendered element. */
      element?: "button";
      /** Native button type. */
      type?: "button" | "submit" | "reset";
      /** Disable the button. */
      disabled?: boolean;
      href?: never;
    })
  | (Omit<HTMLAttributes<"a">, "type"> & {
      element: "link";
      /** Link destination. */
      href?: string;
      type?: never;
      disabled?: never;
    });

type Kind =
  | {
      /** Button type. */
      variant?: "main";
      /** Visual emphasis. */
      emphasis?: Emphasis;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "link";
      /** A link carries no weight of its own: it is already the quietest. */
      emphasis?: never;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "play";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Play` or `Pause`. */
      label?: string;
      /** Show the pause icon and pressed state. */
      pressed?: boolean;
      direction?: never;
    }
  | {
      variant: "close";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Close`. */
      label?: string;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "arrow";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Next` or `Previous`. */
      label?: string;
      pressed?: never;
      /** Arrow direction. */
      direction?: "forward" | "back";
    };

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
} & Tag &
  Kind;

type AllProps = HTMLAttributes<"button"> &
  Omit<HTMLAttributes<"a">, "type"> & {
    render?: boolean;
    variant?: "main" | "link" | "play" | "close" | "arrow";
    emphasis?: Emphasis;
    label?: string;
    pressed?: boolean;
    direction?: "forward" | "back";
    element?: "button" | "link";
    href?: string;
    type?: "button" | "submit" | "reset";
  };

const {
  render = true,
  variant = "main",
  emphasis = "primary",
  label,
  pressed = false,
  direction = "forward",
  element = "button",
  href,
  type = "button",
  class: className,
  ...rest
} = Astro.props as AllProps;

const isLink = element === "link";
const Tag = isLink ? "a" : "button";
const tagAttrs = isLink
  ? { href: href || "#" }
  : { type: type === "submit" ? undefined : type };

const marks = { play, close, arrow };
/* main and link are written, the rest are marks with a label. */
const isWritten = variant === "main" || variant === "link";
const content = isWritten ? await slotContent(Astro.slots) : "";

const named = {
  play: pressed ? "Pause" : "Play",
  close: "Close",
  arrow: direction === "back" ? "Previous" : "Next",
};
---

{
  render && (isWritten ? content : true) && (
    <Tag
      class:list={[
        variant === "link" ? "button_link_wrap" : "button_main_wrap",
        variant !== "link" && emphasis !== "primary" && `is-${emphasis}`,
        !isWritten && "is-icon",
        variant === "play" && "is-play",
        variant === "arrow" && direction === "back" && "is-back",
        className,
      ]}
      aria-label={isWritten ? undefined : (label ?? named[variant])}
      aria-pressed={variant === "play" ? pressed : undefined}
      {...tagAttrs}
      {...rest}
    >
      {variant === "link" ? (
        <span class="button_link_element">
          <span class="button_link_text">
            <Fragment set:html={content} />
          </span>
          <span class="button_link_line" aria-hidden="true" />
        </span>
      ) : (
        <span class="button_main_element">
          {variant === "main" && (
            <span class="button_main_text">
              <Fragment set:html={content} />
            </span>
          )}
          {variant === "play" && (
            <Fragment>
              <Icon class="button_main_icon is-play" src={play} />
              <Icon class="button_main_icon is-pause" src={pause} />
            </Fragment>
          )}
          {variant === "close" && (
            <Icon class="button_main_icon" src={marks.close} />
          )}
          {variant === "arrow" && (
            <Icon class="button_main_icon" src={marks.arrow} />
          )}
        </span>
      )}
    </Tag>
  )
}

<style is:global>
  @layer components {
    :is(.button_main_wrap, .button_link_wrap) {
      text-decoration: none;
      @media (hover: hover) {
        &:hover:not(:disabled) {
          --_trigger---on: 0;
          --_trigger---off: 1;
        }
      }
      &:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }
    }
    .button_link_wrap {
      display: inline-flex;
    }
    .button_main_wrap {
      &.is-icon {
        border-radius: var(--_sizing---radius--full);
        & .button_main_element {
          padding: var(--_sizing---space--0-75);
        }
      }
      &.is-back .button_main_icon {
        rotate: 180deg;
      }
      &.is-play .button_main_icon.is-pause {
        display: none;
      }
      &.is-play[aria-pressed="true"] {
        & .button_main_icon.is-play {
          display: none;
        }
        & .button_main_icon.is-pause {
          display: block;
        }
      }
    }
  }
</style>
